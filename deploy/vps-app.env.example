# Copie para a raiz do projeto na VPS como arquivo .env (não commite).
# Ajuste AUTH_URL para a URL pública do site (https://seu-dominio.com), sem barra no final.

# --- Banco (Postgres Docker no mesmo servidor — ver deploy/postgres.env) ---
DATABASE_URL="postgresql://kanbamlicita:SUA_SENHA_AQUI@127.0.0.1:5432/kanbamlicita"

# --- NextAuth (obrigatório em produção) ---
AUTH_SECRET="gere_com_openssl_rand_base64_32"
AUTH_URL="https://seu-dominio.com"

# --- IA (opcional; deixe em branco se não usar) ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-3-5-sonnet-20241022

# --- App ---
NODE_ENV=production
PORT=3000
